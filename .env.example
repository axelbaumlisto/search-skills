# Copy to ~/.config/search-skills/.env (chmod 600). Everything here is optional
# except the Telegram credentials, which have no other source.

# ---- shared -----------------------------------------------------------------
# SEARCH_SKILLS_HOME=~/.config/search-skills   # where cookies/sessions/state live
# PYTHON_BIN=python3
# CHROME_PROFILE=Default                       # Chrome profile to export cookies from

# ---- telegram ---------------------------------------------------------------
TG_API_ID=
TG_API_HASH=
# TG_SESSION=default
# TG_SESSION_DIR=~/.config/search-skills/tg
# second identity, used by --account research
# TG_API_ID_RESEARCH=
# TG_API_HASH_RESEARCH=

# ---- facebook ---------------------------------------------------------------
# FB_COOKIES=~/.config/search-skills/facebook.cookies.txt
# FB_TEMPLATE=~/.config/search-skills/fb_marketplace_graphql.json
# FB_STATE=~/.config/search-skills/fb_local_state.json
# FB_REMOTE=                                   # optional ssh host with a logged-in Chrome + CDP
# FB_LOCAL_SESSION=auto                        # 1 = run here, 0 = run on FB_REMOTE

# ---- shopee -----------------------------------------------------------------
# SHOPEE_COOKIES=~/.config/search-skills/shopee.cookies.txt
# SHOPEE_NODE_MODULES=./node_modules           # where playwright is installed
# SHOPEE_BRIDGE_APP=~/Applications/ChromeBridge.app
# SHOPEE_BRIDGE_DIR=/tmp/search-skills-bridge
# SHOPEE_DEBUG=1                               # print built URLs and accepted/skipped XHRs
