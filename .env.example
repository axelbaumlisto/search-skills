# Copy to $HOME/.config/search-skills/.env (chmod 600). Everything here is optional
# except the Telegram credentials, which have no other source.
#
# NOTE: only the Telegram scripts read this file. Shopee and Facebook variables
# must be exported in your shell — they all have working defaults, so an empty
# environment works out of the box.

# ---- shared -----------------------------------------------------------------
# SEARCH_SKILLS_HOME=$HOME/.config/search-skills   # where cookies/sessions/state live
# PYTHON_BIN=python3
# CHROME_PROFILE=Default                       # Chrome profile to export cookies from

# ---- telegram ---------------------------------------------------------------
TG_API_ID=
TG_API_HASH=
# TG_SESSION=default
# TG_SESSION_DIR=$HOME/.config/search-skills/tg
# second identity, used by --account research
# TG_API_ID_RESEARCH=
# TG_API_HASH_RESEARCH=

# ---- facebook ---------------------------------------------------------------
# FB_COOKIES=$HOME/.config/search-skills/facebook.cookies.txt
# FB_TEMPLATE=$HOME/.config/search-skills/fb_marketplace_graphql.json
# FB_STATE=$HOME/.config/search-skills/fb_local_state.json

# ---- shopee -----------------------------------------------------------------
# SHOPEE_HOME=$HOME/.config/search-skills          # Shopee's own alias for SEARCH_SKILLS_HOME
# SHOPEE_COOKIES=$HOME/.config/search-skills/shopee.cookies.txt
# SHOPEE_NODE_MODULES=./node_modules           # where playwright is installed
# SHOPEE_BRIDGE_APP=$HOME/Applications/ChromeBridge.app
# SHOPEE_BRIDGE_DIR=$HOME/.config/search-skills/bridge  # must be set BEFORE build_bridge.sh runs
# SHOPEE_DEBUG=1                               # print built URLs and accepted/skipped XHRs
